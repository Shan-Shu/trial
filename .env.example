# ==================== 模型提供商 API Key（按需填写）====================

# OpenAI 或任何 OpenAI 兼容接口（默认）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问 DashScope 兼容模式（https://help.aliyun.com/zh/model-studio）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Anthropic Claude（https://console.anthropic.com）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini（https://aistudio.google.com/apikey）
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ==================== 演示 / 角色配置 ====================

# 默认提供商（不填时 = openai）
LLM_PROVIDER=openai

# 设为 1 时，演示脚本调用真实模型（需要至少一组有效 API Key）；
# 留空 / 0 时使用内置本地占位模型，纯离线验证流程。
RESEARCH_AGENT_REAL=0

# 多模型演示中三个角色的提供商
WORKER_A_PROVIDER=openai
WORKER_B_PROVIDER=deepseek
CHAIR_PROVIDER=anthropic

# 演示主题（可选，默认内置示例主题）
DEMO_TOPIC=

# ==================== 科研检索工具（可选）====================
# https://tavily.com 申请，用于 langchain-community 的 TavilySearchResults
TAVILY_API_KEY=
# Semantic Scholar API Key（可选，能提升免费额度，缓解 429）
SEMANTIC_SCHOLAR_API_KEY=
# Unpaywall 需要有效邮箱才能返回 OA PDF
UNPAYWALL_EMAIL=research-agent@example.com

# ==================== 数据构建链 LLM 绑定 ====================
# 除审核校对外，各 LLM 角色均使用 DeepSeek V4 Flash
DEEPSEEK_API_KEY=
RETRIEVAL_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=
QUALITY_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
KNOWLEDGE_MODEL=deepseek-v4-flash

# ==================== 研究任务五节点 ====================
# Planner / Consumer / Content / Reviewer / FactCheck 统一使用 DeepSeek V4 Pro 与同一 DEEPSEEK_API_KEY
PLANNER_MODEL=deepseek-v4-pro
CONSUMER_MODEL=deepseek-v4-pro
CONTENT_MODEL=deepseek-v4-pro
REVIEW_MODEL=deepseek-v4-pro
FACT_CHECK_MODEL=deepseek-v4-pro

# ==================== DeepSeek 高级参数（v0.4.1） ====================
# 默认不发送 reasoning_effort：实测显式传 low 时，长提示词（6 万字符）请求可能
# 长时间不返回；不传该参数时同一提示词约 6 分钟返回。需要时取消注释启用。
# DEEPSEEK_REASONING_EFFORT=low
# 单次响应最大输出 token（默认 8000）
# DEEPSEEK_MAX_TOKENS=8000
# 研究任务节点超时（秒）：超时后节点降级为确定性实现，避免整条链路被单个请求拖死
# RA_STUDY_CONSUMER_TIMEOUT=900
# RA_STUDY_CONTENT_TIMEOUT=900
# RA_STUDY_REVIEW_TIMEOUT=600
# RA_STUDY_FACT_CHECK_TIMEOUT=600

# 可选：覆盖角色默认 provider（openai/deepseek/qwen/glm/anthropic/google）
ROLE_PROVIDER_RETRIEVER=deepseek
ROLE_PROVIDER_QUALITY=deepseek
ROLE_PROVIDER_KNOWLEDGE=deepseek
ROLE_PROVIDER_PLANNER=deepseek
ROLE_PROVIDER_CONSUMER=deepseek
ROLE_PROVIDER_CONTENT=deepseek
ROLE_PROVIDER_REVIEW=deepseek
ROLE_PROVIDER_FACT_CHECK=deepseek

# ==================== 质量控制 / 本体规模配置 ====================
# 新增本体节点每满 300 个时，按 IUPAC Gold Book / ChEBI 词典做全局归并
RA_GLOBAL_MERGE=1
RA_GLOBAL_MERGE_INTERVAL_NODES=300
