# ==================== 模型提供商 API Key（按需填写）====================

# OpenAI 或任何 OpenAI 兼容接口（默认）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问 DashScope 兼容模式（https://help.aliyun.com/zh/model-studio）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Anthropic Claude（https://console.anthropic.com）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini（https://aistudio.google.com/apikey）
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ==================== 演示 / 角色配置 ====================

# 默认提供商（不填时 = openai）
LLM_PROVIDER=openai

# 设为 1 时，演示脚本调用真实模型（需要至少一组有效 API Key）；
# 留空 / 0 时使用内置本地占位模型，纯离线验证流程。
RESEARCH_AGENT_REAL=0

# 多模型演示中三个角色的提供商
WORKER_A_PROVIDER=openai
WORKER_B_PROVIDER=deepseek
CHAIR_PROVIDER=anthropic

# 演示主题（可选，默认内置示例主题）
DEMO_TOPIC=

# ==================== 科研检索工具（可选）====================
# https://tavily.com 申请，用于 langchain-community 的 TavilySearchResults
TAVILY_API_KEY=

# ==================== 三节点 LLM 绑定（默认已按你的要求设定）====================
# 文献检索节点 → DeepSeek V4
DEEPSEEK_API_KEY=
RETRIEVAL_MODEL=deepseek-v4-pro      # DeepSeek V4（轻量可用 deepseek-v4-flash）
# 质量评估节点 → GLM 4.7 Flash（智谱开放平台 BigModel）
ZHIPU_API_KEY=
QUALITY_MODEL=glm-4.7-flash
# 知识提取节点 → DeepSeek V4 Pro（临时替代 OpenAI gpt-5.6，当前网络 OpenAI 不可达）
OPENAI_API_KEY=
KNOWLEDGE_MODEL=deepseek-v4-pro      # DeepSeek V4 Pro（临时替代 gpt-5.6）
# 可选：覆盖角色默认 provider（openai/deepseek/qwen/glm/anthropic/google）
# ROLE_PROVIDER_RETRIEVER=deepseek
# ROLE_PROVIDER_QUALITY=glm
# ROLE_PROVIDER_KNOWLEDGE=deepseek
